{{!
    @template local_termplanner/plan

    The plan editor: one card per school week, rows for the week's activities and text lines.

    Example context (json):
    {
        "title": "Chem A · Tri 2", "term": "Tri 2 2026-27", "audience": "everyone in the course",
        "published": "Not published yet", "pending": 3, "settingsurl": "#", "backurl": "#", "gridurl": "#", "action": "#",
        "sesskey": "abc", "min": "2026-11-30", "max": "2027-03-05", "ok": true, "problems": [],
        "weeks": [{"number": 1, "range": "11/30 – 12/4", "schooldays": "4 school days", "notes": "Mon Staff day",
            "flags": "", "hasitems": true, "preview": "<ul><li>Do CFA’s</li></ul>",
            "adddays": [{"value": "2026-12-01", "label": "Tue 12/1"}],
            "activities": [{"label": "Topic 00", "options": [{"value": 5, "label": "CFA Section 0.1: Classification of Matter"}]}],
            "items": [{"id": 1, "istext": false, "name": "CFA Section 0.1: Classification of Matter", "kind": "cfa",
                "kindlabel": "CFA", "day": "2026-12-01", "dayname": "Tue", "indent": 0,
                "levels": [{"value": 0, "label": "0", "selected": true}], "islab": false, "flagged": false,
                "first": true, "last": true}]}]
    }
}}
<div class="local-termplanner">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="mb-0 me-2">{{title}}</h2>
        <span class="badge bg-secondary">{{term}}</span>
        <span class="text-muted small">{{#str}} publishaudience, local_termplanner, {{audience}} {{/str}}</span>
    </div>
    <p class="small mb-3">
        <a href="{{backurl}}">{{#str}} back, local_termplanner {{/str}}</a> ·
        <a href="{{settingsurl}}">{{#str}} editplan, local_termplanner {{/str}}</a> ·
        <a href="{{gridurl}}">{{#str}} gridview, local_termplanner {{/str}}</a> ·
        <span class="text-muted">{{published}}</span>
    </p>

    <form method="post" action="{{action}}" class="tp-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="tp-bar d-flex flex-wrap gap-2 align-items-center p-2 mb-3 border rounded bg-body">
            <button type="submit" name="save" value="1" class="btn btn-secondary">{{#str}} save, local_termplanner {{/str}}</button>
            <button type="submit" name="publish" value="1" class="btn btn-primary">
                {{#str}} publish, local_termplanner {{/str}}{{#pending}} <span class="badge bg-light text-dark ms-1">{{pending}}</span>{{/pending}}
            </button>
        </div>

        <section class="mb-4" aria-labelledby="tp-checks">
            <h3 class="h5" id="tp-checks">{{#str}} checks, local_termplanner {{/str}}</h3>
            {{#ok}}<div class="alert alert-success py-2 mb-0">{{#str}} checksok, local_termplanner {{/str}}</div>{{/ok}}
            {{^ok}}
            <ul class="list-unstyled mb-0">
                {{#problems}}<li class="alert alert-warning py-1 px-2 mb-1">{{#anchor}}<a href="#{{anchor}}">{{/anchor}}{{message}}{{#anchor}}</a>{{/anchor}}</li>{{/problems}}
            </ul>
            {{/ok}}
        </section>

        {{#weeks}}
        {{#isbreak}}
        <div class="tp-break p-2 mb-3 rounded text-muted small"><strong>{{range}}</strong> · {{label}}</div>
        {{/isbreak}}
        {{^isbreak}}
        <section class="card mb-3" id="week{{number}}">
            <div class="card-header d-flex flex-wrap gap-2 align-items-baseline">
                <h3 class="h5 mb-0">{{#str}} week, local_termplanner, {{number}} {{/str}}</h3>
                <span class="text-muted small">{{range}} · {{schooldays}}{{#notes}} · {{notes}}{{/notes}}</span>
                {{#flags}}<span class="badge bg-warning text-dark">⚠ {{flags}}</span>{{/flags}}
            </div>
            <div class="card-body p-2">
                {{#hasitems}}
                <div class="table-responsive">
                <table class="table table-sm align-middle mb-2 tp-items">
                    <thead><tr>
                        <th scope="col">{{#str}} day, local_termplanner {{/str}}</th>
                        <th scope="col">{{#str}} level, local_termplanner {{/str}}</th>
                        <th scope="col"></th>
                        <th scope="col">{{#str}} labdeadlines, local_termplanner {{/str}}</th>
                        <th scope="col"><span class="visually-hidden">{{#str}} actions {{/str}}</span></th>
                    </tr></thead>
                    <tbody>
                    {{#items}}
                    <tr class="{{#flagged}}tp-flagged{{/flagged}}">
                        <td class="text-nowrap">
                            <span class="tp-dayname text-muted">{{dayname}}</span>
                            <input type="date" class="form-control form-control-sm d-inline-block w-auto" name="day[{{id}}]" value="{{day}}" min="{{min}}" max="{{max}}" aria-label="{{#str}} day, local_termplanner {{/str}}">
                        </td>
                        <td>
                            <select class="form-select form-select-sm w-auto" name="level[{{id}}]" aria-label="{{#str}} level, local_termplanner {{/str}}">
                                {{#levels}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/levels}}
                            </select>
                        </td>
                        <td class="tp-name tp-indent-{{indent}}">
                            {{#istext}}<input type="text" class="form-control form-control-sm" name="text[{{id}}]" value="{{text}}" aria-label="{{#str}} textline, local_termplanner {{/str}}">{{/istext}}
                            {{^istext}}<span class="tp-kind tp-kind-{{kind}}">{{kindlabel}}</span> {{name}}{{/istext}}
                        </td>
                        <td>
                            {{#islab}}
                            <div class="tp-deadlines">
                                <label class="small text-muted mb-0" for="tp-closes-{{id}}">{{#str}} closesday, local_termplanner {{/str}}</label>
                                <input type="date" id="tp-closes-{{id}}" class="form-control form-control-sm" name="closes[{{id}}]" value="{{closes}}" min="{{min}}" max="{{max}}">
                                <label class="small text-muted mb-0" for="tp-check-{{id}}">{{#str}} checkday, local_termplanner {{/str}}</label>
                                <input type="date" id="tp-check-{{id}}" class="form-control form-control-sm" name="check[{{id}}]" value="{{check}}" min="{{min}}" max="{{max}}">
                            </div>
                            <button type="submit" name="reset" value="{{id}}" class="btn btn-link btn-sm p-0">{{#str}} resetdeadlines, local_termplanner {{/str}}</button>
                            {{/islab}}
                        </td>
                        <td class="text-nowrap text-end">
                            <button type="submit" name="up" value="{{id}}" class="btn btn-sm btn-outline-secondary" {{#first}}disabled{{/first}} title="{{#str}} moveup, local_termplanner {{/str}}" aria-label="{{#str}} moveup, local_termplanner {{/str}}">↑</button>
                            <button type="submit" name="down" value="{{id}}" class="btn btn-sm btn-outline-secondary" {{#last}}disabled{{/last}} title="{{#str}} movedown, local_termplanner {{/str}}" aria-label="{{#str}} movedown, local_termplanner {{/str}}">↓</button>
                            <button type="submit" name="del" value="{{id}}" class="btn btn-sm btn-outline-danger" title="{{#str}} deleteitem, local_termplanner {{/str}}" aria-label="{{#str}} deleteitem, local_termplanner {{/str}}">×</button>
                        </td>
                    </tr>
                    {{/items}}
                    </tbody>
                </table>
                </div>
                {{/hasitems}}
                <div class="d-flex flex-wrap gap-2 align-items-center tp-add">
                    <span class="small text-muted">{{#str}} addtoweek, local_termplanner, {{number}} {{/str}}</span>
                    <select class="form-select form-select-sm w-auto" name="addday[{{number}}]" aria-label="{{#str}} day, local_termplanner {{/str}}">
                        {{#adddays}}<option value="{{value}}">{{label}}</option>{{/adddays}}
                    </select>
                    <select class="form-select form-select-sm tp-addcm" name="addcm[{{number}}]" aria-label="{{#str}} addactivity, local_termplanner {{/str}}">
                        <option value="0">{{#str}} addactivity, local_termplanner {{/str}}…</option>
                        {{#activities}}<optgroup label="{{label}}">{{#options}}<option value="{{value}}">{{label}}</option>{{/options}}</optgroup>{{/activities}}
                    </select>
                    <input type="text" class="form-control form-control-sm tp-addtext" name="addtext[{{number}}]" placeholder="{{#str}} addline, local_termplanner {{/str}}" aria-label="{{#str}} addline, local_termplanner {{/str}}">
                    <select class="form-select form-select-sm w-auto" name="addlevel[{{number}}]" aria-label="{{#str}} level, local_termplanner {{/str}}">
                        <option value="0">0</option><option value="1">→</option><option value="2">→→</option>
                    </select>
                    <button type="submit" name="add" value="{{number}}" class="btn btn-sm btn-outline-primary">{{#str}} additem, local_termplanner {{/str}}</button>
                </div>
                {{#preview}}
                <details class="mt-2">
                    <summary class="small">{{#str}} preview, local_termplanner {{/str}}</summary>
                    <div class="tp-preview border rounded p-2 mt-1 small">{{{preview}}}</div>
                </details>
                {{/preview}}
            </div>
        </section>
        {{/isbreak}}
        {{/weeks}}
    </form>
</div>
