<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/termplanner/db" VERSION="20261126" COMMENT="XMLDB file for local/termplanner"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_termplanner_term" COMMENT="School terms (trimesters, semesters) with their first and last day">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startday" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="First day, YYYY-MM-DD"/>
        <FIELD NAME="endday" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last day, YYYY-MM-DD"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_termplanner_day" COMMENT="Special days in a term: no school, early release, finals">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="termid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="day" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="type" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="noschool, early or finals"/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="termid" TYPE="foreign" FIELDS="termid" REFTABLE="local_termplanner_term" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="termday" UNIQUE="true" FIELDS="termid, day"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_termplanner_plan" COMMENT="A course's plan for one term">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="termid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="eventprefix" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Week events are named prefix + W + number"/>
        <FIELD NAME="eventday" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="last" SEQUENCE="false" COMMENT="last, first or span"/>
        <FIELD NAME="groupids" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Comma-separated group ids; empty = whole course"/>
        <FIELD NAME="timepublished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="termid" TYPE="foreign" FIELDS="termid" REFTABLE="local_termplanner_term" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_termplanner_item" COMMENT="One line of a plan: a course activity or a line of text, on a school day">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="day" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course module, 0 for a text line"/>
        <FIELD NAME="text" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="level" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Indent level in the week list"/>
        <FIELD NAME="closesday" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Labs: last day to do the lab"/>
        <FIELD NAME="checkday" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Labs: last day to check off"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="planid" TYPE="foreign" FIELDS="planid" REFTABLE="local_termplanner_plan" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_termplanner_event" COMMENT="Calendar events a plan has published, so republishing updates them in place">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="eventkey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="week:N, closes:ITEMID or check:ITEMID, plus :gGROUPID"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="planid" TYPE="foreign" FIELDS="planid" REFTABLE="local_termplanner_plan" REFFIELDS="id"/>
        <KEY NAME="eventid" TYPE="foreign" FIELDS="eventid" REFTABLE="event" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="planevent" UNIQUE="true" FIELDS="planid, eventkey"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
